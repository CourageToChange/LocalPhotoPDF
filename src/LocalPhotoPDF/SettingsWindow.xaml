<Window x:Class="LocalPhotoPDF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalPhotoPDF settings"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Appearance -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabelStyle}"
                           FontSize="16"
                           Text="Appearance" />

                <Label x:Name="ThemeLabel"
                       Padding="0"
                       Margin="0,4,0,7"
                       FontWeight="SemiBold"
                       Content="_Theme"
                       Target="{Binding ElementName=ThemeCombo}" />
                <ComboBox x:Name="ThemeCombo"
                          AutomationProperties.Name="Theme"
                          AutomationProperties.HelpText="Choose whether the app is dark, light, or follows your Windows setting." />
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Dark by default. The change applies as soon as you save." />
            </StackPanel>
        </Border>

        <!-- Saving -->
        <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabelStyle}"
                           FontSize="16"
                           Text="Saving" />

                <Label x:Name="FolderLabel"
                       Padding="0"
                       Margin="0,4,0,7"
                       FontWeight="SemiBold"
                       Content="Default _folder for new PDFs"
                       Target="{Binding ElementName=FolderBox}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox"
                             Grid.Column="0"
                             VerticalContentAlignment="Center"
                             MinHeight="36"
                             Padding="10,5"
                             IsReadOnly="True"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}"
                             BorderThickness="1"
                             AutomationProperties.Name="Default save folder" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            MinWidth="90"
                            Style="{StaticResource QuietButtonStyle}"
                            Content="_Browse…"
                            Click="BrowseButton_Click"
                            AutomationProperties.Name="Choose default save folder" />
                    <Button x:Name="ResetFolderButton"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            MinWidth="70"
                            Style="{StaticResource QuietButtonStyle}"
                            Content="_Reset"
                            Click="ResetFolderButton_Click"
                            AutomationProperties.Name="Reset default save folder"
                            AutomationProperties.HelpText="Go back to using your Documents folder." />
                </Grid>
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Where the Save dialog opens. You can still save anywhere you like." />

                <CheckBox x:Name="OpenFolderCheck"
                          Margin="0,16,0,0"
                          Foreground="{DynamicResource ForegroundBrush}"
                          Content="Open the folder after creating a PDF"
                          AutomationProperties.Name="Open the folder after creating a PDF" />
            </StackPanel>
        </Border>

        <!-- Privacy reassurance, matching the wording on the main window. -->
        <TextBlock Grid.Row="2"
                   Margin="4,16,4,0"
                   FontSize="12"
                   Style="{StaticResource MutedTextStyle}"
                   Text="These preferences are stored on this PC only, in your local app data folder. Nothing is sent anywhere." />

        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    MinWidth="110"
                    Style="{StaticResource QuietButtonStyle}"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click" />
            <Button x:Name="SaveButton"
                    Margin="10,0,0,0"
                    MinWidth="130"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Save settings"
                    IsDefault="True"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>

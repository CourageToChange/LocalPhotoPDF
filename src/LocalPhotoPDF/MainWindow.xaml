<Window x:Class="LocalPhotoPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LocalPhotoPDF"
        Width="1180"
        Height="780"
        MinWidth="940"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Closing="Window_Closing"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        AutomationProperties.Name="LocalPhotoPDF photo to PDF converter">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Original LocalPhotoPDF mark: a photo outline paired with a PDF page. -->
            <Border Grid.Column="0"
                    Width="50"
                    Height="50"
                    Margin="0,0,14,0"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="12"
                    AutomationProperties.Name="LocalPhotoPDF logo">
                <Canvas Width="44" Height="44">
                    <Path Data="M 6,10 L 28,10 L 28,27 L 6,27 Z M 8,24 L 14,18 L 18,22 L 22,16 L 27,23"
                          Stroke="White"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                    <Ellipse Canvas.Left="10" Canvas.Top="13" Width="4" Height="4" Fill="White" />
                    <Path Data="M 25,18 L 35,18 L 39,22 L 39,36 L 25,36 Z M 35,18 L 35,22 L 39,22"
                          Fill="#FFF4F7FF"
                          Stroke="White"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round" />
                    <TextBlock Canvas.Left="27" Canvas.Top="24"
                               FontFamily="Segoe UI"
                               FontSize="7"
                               FontWeight="Bold"
                               Foreground="#FF1D4ED8"
                               Text="PDF" />
                </Canvas>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="25" FontWeight="SemiBold" Text="LocalPhotoPDF" />
                <TextBlock Margin="0,3,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Turn photos into a clean PDF — privately on your PC." />
            </StackPanel>

            <Button x:Name="AddPhotosButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="＋  Add _Photos"
                    Click="AddPhotosButton_Click"
                    IsEnabled="{Binding CanEdit}"
                    ToolTip="Choose photos from this PC (Ctrl+O)"
                    AutomationProperties.Name="Add photos"
                    AutomationProperties.HelpText="Choose one or more photo files from this PC." />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,14"
                Padding="14,11"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.LiveSetting="Polite">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="30"
                        Height="30"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="15">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="{Binding NoticeIcon}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="{Binding NoticeTitle}" />
                    <TextBlock Margin="0,3,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="{Binding NoticeMessage}" />
                    <StackPanel Margin="0,10,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding HasOutput, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource QuietButtonStyle}"
                                Content="_Open PDF"
                                Command="{Binding OpenPdfCommand}"
                                AutomationProperties.Name="Open generated PDF" />
                        <Button Style="{StaticResource QuietButtonStyle}"
                                Content="Show in _Folder"
                                Command="{Binding ShowInFolderCommand}"
                                AutomationProperties.Name="Show generated PDF in folder" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2"
                        Width="30"
                        Height="30"
                        Padding="0"
                        VerticalAlignment="Top"
                        Style="{StaticResource QuietButtonStyle}"
                        Content="×"
                        Command="{Binding DismissNoticeCommand}"
                        ToolTip="Dismiss message"
                        AutomationProperties.Name="Dismiss message" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="540" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Photos" />
                            <Border Margin="9,1,0,0"
                                    Padding="7,2"
                                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    CornerRadius="8">
                                <TextBlock FontSize="12" Text="{Binding PhotoCountText}" />
                            </Border>
                            <TextBlock Margin="12,2,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="{Binding ImportStatus}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource QuietButtonStyle}"
                                Content="Clear _All"
                                Command="{Binding ClearCommand}"
                                ToolTip="Remove every photo from the list"
                                AutomationProperties.Name="Clear all photos" />
                    </Grid>

                    <Grid Grid.Row="1"
                          Height="112"
                          Margin="0,0,0,14"
                          IsEnabled="{Binding CanEdit}"
                          MouseLeftButtonUp="DropZone_MouseLeftButtonUp"
                          Cursor="Hand"
                          AutomationProperties.Name="Photo drop zone"
                          AutomationProperties.HelpText="Drop photo files here or activate to browse.">
                        <Rectangle Fill="Transparent"
                                   Stroke="{StaticResource AccentBrush}"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="4,3"
                                   RadiusX="10"
                                   RadiusY="10" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Drop photos here" />
                            <TextBlock Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="or click to browse • up to 500 photos" />
                            <TextBlock Margin="0,3,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="JPEG, PNG, BMP, GIF, TIFF, JPEG XR and formats supported by Windows" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="Your page list will appear here" />
                            <TextBlock Margin="0,6,0,0"
                                       MaxWidth="360"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Photos are kept in the order you add them. You can reorder and rotate them before creating the PDF." />
                        </StackPanel>

                        <ListBox x:Name="PhotoList"
                                 ItemsSource="{Binding Photos}"
                                 SelectedItem="{Binding SelectedPhoto}"
                                 Visibility="{Binding HasPhotos, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 AllowDrop="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewMouseLeftButtonDown="PhotoList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="PhotoList_PreviewMouseMove"
                                 DragOver="PhotoList_DragOver"
                                 Drop="PhotoList_Drop"
                                 AutomationProperties.Name="Ordered photos">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                       Text="⋮⋮"
                                                       ToolTip="Drag to reorder"
                                                       AutomationProperties.Name="Drag to reorder" />

                                            <Border Grid.Column="1"
                                                    Width="72"
                                                    Height="72"
                                                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                                    CornerRadius="6"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       RenderTransformOrigin="0.5,0.5"
                                                       AutomationProperties.Name="{Binding DisplayName}">
                                                    <Image.RenderTransform>
                                                        <RotateTransform Angle="{Binding RotationDegrees}" />
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Border>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}" />
                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="12"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Text="{Binding Details}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Text="{Binding Position, StringFormat=PDF page {0}}" />
                                            </StackPanel>

                                            <WrapPanel Grid.Column="4"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Content="↑"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Move up (Alt+Up Arrow)"
                                                        AutomationProperties.Name="Move photo up" />
                                                <Button Margin="4,0,0,0"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Content="↓"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Move down (Alt+Down Arrow)"
                                                        AutomationProperties.Name="Move photo down" />
                                                <Button Margin="8,0,0,0"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Content="↶"
                                                        Command="{Binding DataContext.RotateLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Rotate left"
                                                        AutomationProperties.Name="Rotate photo left" />
                                                <Button Margin="4,0,0,0"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Content="↷"
                                                        Command="{Binding DataContext.RotateRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Rotate right"
                                                        AutomationProperties.Name="Rotate photo right" />
                                                <Button Margin="8,0,0,0"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Content="×"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove photo (Delete)"
                                                        AutomationProperties.Name="Remove photo" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" IsEnabled="{Binding CanEdit}">
                        <TextBlock Margin="0,0,0,18" FontSize="18" FontWeight="SemiBold" Text="PDF settings" />

                        <Label x:Name="PageSizeLabel"
                               Padding="0"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold"
                               Content="_Page size"
                               Target="{Binding ElementName=PageSizeCombo}" />
                        <ComboBox x:Name="PageSizeCombo"
                                  ItemsSource="{Binding PageSizeChoices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding PageSize}"
                                  AutomationProperties.Name="Page size" />
                        <TextBlock Margin="0,6,0,20"
                                   FontSize="12"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding PageSizeDescription}" />

                        <Label x:Name="MarginLabel"
                               Padding="0"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold"
                               Content="_Margin"
                               Target="{Binding ElementName=MarginCombo}" />
                        <ComboBox x:Name="MarginCombo"
                                  ItemsSource="{Binding MarginChoices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Margin}"
                                  AutomationProperties.Name="Page margin" />
                        <TextBlock Margin="0,6,0,20"
                                   FontSize="12"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding MarginDescription}" />

                        <Label x:Name="QualityLabel"
                               Padding="0"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold"
                               Content="_Quality"
                               Target="{Binding ElementName=QualityCombo}" />
                        <ComboBox x:Name="QualityCombo"
                                  ItemsSource="{Binding QualityChoices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Quality}"
                                  AutomationProperties.Name="Image quality" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding QualityDescription}" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="0,22,0,0"
                            Padding="12"
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="🔒  Private by design" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="12"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Everything happens offline. Photos, filenames and history are never uploaded or saved by the app." />
                        </StackPanel>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,18,0,0" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="2,0,20,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,0,0,7"
                               FontWeight="SemiBold"
                               Text="Creating your PDF…"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercentage, Mode=OneWay}"
                                 AutomationProperties.Name="PDF creation progress" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Style="{StaticResource MutedTextStyle}"
                               Text="{Binding ProgressText}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <StackPanel Grid.Column="0"
                            Margin="2,0,20,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontWeight="SemiBold" Text="Ready to make your PDF?" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Photos are fitted and centred without cropping. The originals are never changed." />
                </StackPanel>

                <Button Grid.Column="1"
                        MinWidth="160"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Generate _PDF"
                        Click="GeneratePdfButton_Click"
                        IsEnabled="{Binding CanGenerate}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Choose where to save and create the PDF (Ctrl+G)"
                        AutomationProperties.Name="Generate PDF" />

                <Button Grid.Column="1"
                        MinWidth="130"
                        Style="{StaticResource QuietButtonStyle}"
                        Content="_Cancel"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Cancel safely (Escape)"
                        AutomationProperties.Name="Cancel PDF creation" />
            </Grid>
        </Border>
    </Grid>
</Window>

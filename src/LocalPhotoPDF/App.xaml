<Application x:Class="LocalPhotoPDF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <!--
        ThemeMode is "Dark" here and NEVER "System". ThemeService changes it at runtime when the
        user picks a different theme; this attribute only decides what the very first frame looks
        like, and it has to be a concrete value.

        WHY IT IS DECLARED HERE AND NOT ONLY IN CODE. Setting Application.ThemeMode from
        OnStartup does not reach controls that the framework styles itself: the ComboBox and its
        popup came up in the Fluent LIGHT style while the rest of the window was dark, which put
        near-white item text on a white popup. Declaring it in XAML makes WPF load the right
        Fluent dictionary before any control is created.

        WHY "System" IS BANNED. The previous version paired ThemeMode="System" with legacy
        SystemColors.*BrushKey brushes. Those two systems are independent - SystemColors.* returns
        classic Win32 colours that are effectively always light, while the framework theme follows
        Windows - and on a machine set to dark that single mismatch produced BOTH faults
        reported on 2026-08-22:

          * the window forced itself light  ->  "the localphotopdf software is too bright"
          * the popup stayed dark while its items inherited the window's black Foreground
            ->  page size / margin / quality options invisible but still selectable

        So: one palette, and the framework theme is always told to match it. There are no
        SystemColors brushes left in this app, and a test enforces that. Every colour was
        contrast-checked before it was written; the numbers are in Themes/Dark.xaml and Light.xaml.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Swapped at runtime by ThemeService. Dark is the default. -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DecorativeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White" />
                                    <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <!--
                THE FIX for the invisible dropdown options.

                Both halves are set explicitly - the popup SURFACE (in the ComboBox template
                below) and the item TEXT (here). Before, the popup was painted by the framework
                theme while its items inherited the window's foreground, and the two disagreed.

                ⚠️ This style is only half the fix and cannot be removed on its own. The other
                half is the ComboBox ControlTemplate below, which owns the popup background.
            -->
            <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
                <!--
                    A screen reader takes a ComboBoxItem's name from its content, and the content
                    here is an OptionChoice record. Without these two lines it announces the raw
                    record: "OptionChoice { Value = A4, Label = A4 - automatic orientation,
                    Description = Fits each photo to an A4 portrait or landscape page. }".

                    Found 2026-08-24 by reading the UIAutomation tree while verifying the visible
                    fix. The window looked completely correct; only the accessibility tree showed
                    it. A screenshot could never have caught this.
                -->
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ItemSelectedForegroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                An explicit ItemTemplate rather than DisplayMemberPath on each ComboBox.

                This is not cosmetic. A hand-written ControlTemplate has to render the CLOSED
                control itself, via SelectionBoxItem / SelectionBoxItemTemplate, and WPF only
                populates SelectionBoxItemTemplate reliably when ItemTemplate is set explicitly.
                With DisplayMemberPath the closed box fell back to ToString() and read
                "OptionChoice { Value = A4, Label = A4... }".

                ⚠️ WPF throws if DisplayMemberPath and ItemTemplate are both set, so the three
                DisplayMemberPath="Label" attributes were removed from MainWindow.xaml.
            -->
            <DataTemplate x:Key="OptionChoiceTemplate">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>

            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="ItemTemplate" Value="{StaticResource OptionChoiceTemplate}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
                <!--
                    The template is owned here because the framework theme would not follow the
                    app's palette: with ThemeMode set to Dark, both in XAML and in code, the
                    ComboBox and its popup still came up in the Fluent LIGHT style while the rest
                    of the window was dark. That put near-white item text on a white popup - the
                    same unreadable result as the original bug, inverted. Owning the popup is the
                    only way to guarantee the surface and the text agree.
                -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!--
                                    The visible box is drawn directly, and the ToggleButton above
                                    it is an invisible hit target. Nesting the border inside the
                                    ToggleButton's own template looked tidier and did not render:
                                    the control came out with no outline at all. Keeping the two
                                    jobs separate - one element to look right, one to be clicked -
                                    is both more reliable and easier to reason about.
                                -->
                                <Border x:Name="Box"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" />

                                <ToggleButton Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <!-- Transparent still hit-tests; null would not. -->
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                                <Path Margin="0,0,14,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4.5 4.5 L 9 0"
                                      StrokeThickness="1.6"
                                      Stroke="{TemplateBinding Foreground}"
                                      IsHitTestVisible="False" />

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Margin="0,4,0,0"
                                            Padding="4"
                                            Background="{DynamicResource PopupBackgroundBrush}"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,7" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<!--
    Light palette. Same keys as Dark.xaml - the two are swapped wholesale at runtime, so a
    key present in one and missing from the other is a crash waiting to happen. Verified
    ratios:

        body text on window        17.17:1     muted text on window    6.82:1
        body text on card          15.63:1     muted text on card      6.20:1
        DROPDOWN text on popup     17.17:1     white on accent button  5.17:1
        control border vs window    3.70:1     control border vs card   3.37:1
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F4F4F6" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="#1B1B1F" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#5A5A64" />

    <SolidColorBrush x:Key="DecorativeBorderBrush" Color="#D6D6DD" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#84848F" />

    <SolidColorBrush x:Key="ItemHoverBrush" Color="#EAEAEF" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
</ResourceDictionary>

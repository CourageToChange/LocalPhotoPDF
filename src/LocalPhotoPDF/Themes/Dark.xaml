<!--
    Dark palette. Every colour here was checked with a WCAG contrast calculation before it
    was written, not chosen by eye - the bug this file exists to fix WAS a contrast failure.

        body text on window        14.17:1     muted text on window    6.87:1
        body text on card          12.90:1     muted text on card      6.25:1
        DROPDOWN text on popup     11.44:1     white on accent button  5.17:1
        control border vs control   3.27:1     control border vs window 4.05:1

    AA needs 4.5:1 for text and 3:1 for a control boundary (WCAG 1.4.11). The decorative
    card edge is deliberately softer: it is not a control boundary, so it is exempt, and
    forcing it to 3:1 would make the UI look like a spreadsheet.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces, from furthest back to closest. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B1B1F" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#232329" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#2C2C33" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2C2C33" />

    <!-- 🔴 THE ONE THAT CAUSED THE BUG. The ComboBox popup is a SEPARATE visual tree, so
         if it is left unstyled it keeps the framework theme's own background while its
         items inherit the window's Foreground. Mismatch those two and the options are
         invisible but still selectable. Both halves are set explicitly here. -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#2C2C33" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="#E9E9EC" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#A3A3AD" />

    <SolidColorBrush x:Key="DecorativeBorderBrush" Color="#3C3C45" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#7A7A86" />

    <SolidColorBrush x:Key="ItemHoverBrush" Color="#3A3A44" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
</ResourceDictionary>
